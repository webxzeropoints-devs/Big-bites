{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Big Bites Restaurant",
    "version":  "0.1.0",
    "identifier":  "com.vjsan.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build \u0026\u0026 npm --prefix ../server run build \u0026\u0026 npm --prefix ../server run prepare:windows-runtime",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Big Bites Restaurant",
                                    "width":  800,
                                    "height":  600
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "resources":  {
                                     "../../server/dist/": "resources/server/dist/",
                                     "../../server/.windows-runtime/node_modules/": "resources/server/node_modules/",
                                     "../../server/package.json": "resources/server/package.json",
                                     "../../server/prisma/schema.prisma": "resources/server/prisma/schema.prisma",
                                     "../../server/prisma/migrations/": "resources/server/prisma/migrations/",
                                     "../../server/prisma/seed/": "resources/server/prisma/seed/",
                                     "../../server/prisma.config.ts": "resources/server/prisma.config.ts",
                                     "../../server/src/utils/password.ts": "resources/server/src/utils/password.ts",
                                     "windows/Install-BigBites.ps1": "resources/windows/Install-BigBites.ps1",
                                     "windows/Start-BigBitesServer.ps1": "resources/windows/Start-BigBitesServer.ps1",
                                     "windows/Stop-BigBitesServer.ps1": "resources/windows/Stop-BigBitesServer.ps1",
                                     "windows/Initialize-BigBites.ps1": "resources/windows/Initialize-BigBites.ps1",
                                     "windows/node-runtime/node.exe": "resources/windows/node-runtime/node.exe",
                                     "windows/node-runtime/LICENSE": "resources/windows/node-runtime/LICENSE"
                                 },
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "perMachine",
                                                "installerHooks":  "windows/installer.nsh"
                                            }
                               }
               }
}