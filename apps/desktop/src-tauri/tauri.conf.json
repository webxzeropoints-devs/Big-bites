{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Big Bites Restaurant",
  "version": "0.1.0",
  "identifier": "com.vjsan.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm --prefix ../server run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Big Bites Restaurant",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],

    "resources": {
      "../../server/dist/": "resources/server/dist/",
      "../../server/node_modules/": "resources/server/node_modules/",
      "../../server/package.json": "resources/server/package.json",
      "../../server/prisma/": "resources/server/prisma/",
      "../../server/prisma.config.ts": "resources/server/prisma.config.ts",
      "../../server/src/utils/password.ts": "resources/server/src/utils/password.ts",
      "windows/Install-BigBites.ps1": "resources/Install-BigBites.ps1",
      "windows/Start-BigBitesServer.ps1": "resources/Start-BigBitesServer.ps1"
    },

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer.nsh"
      }
    }
  }
}